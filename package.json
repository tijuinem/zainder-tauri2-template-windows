{
  "name": "plantilla-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Plantilla Profesional de Aplicación de Escritorio (Tauri v2 + React)",
  "author": "Plantilla Desktop",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build",
    "build:windows": "npm run build && tauri build",
    "build:app": "vite build && tauri build",
    "preview": "vite preview --outDir build",
    "clean": "node -e \"['build','dist'].forEach(d => fs.rmSync(d, {recursive: true, force: true}))\"",
    "lint": "tsc --noEmit",
    "rename": "node scripts/rename-app.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
