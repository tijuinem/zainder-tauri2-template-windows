{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Zainder",
  "version": "1.0.0",
  "identifier": "com.garba.zainder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zainder — Aplicación de Escritorio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "copyright": "Copyright © 2026 Zainder Desktop",
    "category": "Utility",
    "shortDescription": "Zainder — Plantilla Base para Aplicaciones de Escritorio Modernas en Windows",
    "longDescription": "Zainder: Plantilla profesional y modular para software de escritorio de alto rendimiento en Windows con Tauri v2, Rust y React. Incluye modo frameless, persistencia en AppData, selectores de carpetas y discos, notificaciones nativas, consola de logs e internacionalización."
  }
}
